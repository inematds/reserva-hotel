AGORA = "2026-10-06T09:00"  # terça-feira 06/10/2026 (conferido: datetime.date(2026,10,6).strftime('%a') == 'Tue')


def norm(s):
    """Minúsculas e sem acento, como o bot normaliza o texto para decidir."""
    return "".join(c for c in unicodedata.normalize("NFD", s.lower()) if unicodedata.category(c) != "Mn")


class Cliente:
    def __init__(self, base):
        self.base = base

    def req(self, metodo, rota, corpo=None, token=TOKEN):
        dados = None if corpo is None else json.dumps(corpo).encode()
        r = urllib.request.Request(self.base + rota, data=dados, method=metodo)
        if dados is not None:
            r.add_header("Content-Type", "application/json")
        if token:
            r.add_header("X-Token", token)
        try:
            with urllib.request.urlopen(r, timeout=10) as resp:
                texto = resp.read().decode()
                return resp.status, (json.loads(texto) if texto and "json" in resp.headers.get("Content-Type", "") else texto)
        except urllib.error.HTTPError as e:
            texto = e.read().decode()
            try:
                return e.code, json.loads(texto)
            except ValueError:
                return e.code, texto

    def get(self, rota, **kw):
        return self.req("GET", rota, **kw)

    def post(self, rota, corpo=None, **kw):
        return self.req("POST", rota, {} if corpo is None else corpo, **kw)

    def put(self, rota, corpo=None, **kw):
        return self.req("PUT", rota, {} if corpo is None else corpo, **kw)

    def delete(self, rota, **kw):
        return self.req("DELETE", rota, **kw)

    # atalhos (padrões vêm do fixture; no verificar-independente.py passar tudo explícito)
    def hospede(self, nome="Maria Silva", telefone="(54) 99999-0001", marketing=False):
        st, r = self.post("/api/hospedes", {"nome": nome, "telefone": telefone, "consentimento_marketing": marketing})
        assert st in (200, 201), (st, r)
        return r["id"]

    def reserva(self, hospede_id, checkin, checkout, tipo="standard", adultos=2, criancas=0, origem=None, total=None):
        corpo = {"hospede_id": hospede_id, "tipo": tipo, "checkin": checkin, "checkout": checkout,
                 "adultos": adultos, "criancas": criancas}
        if origem:
            corpo["origem"] = origem
        if total is not None:
            corpo["total"] = total
        return self.post("/api/reservas", corpo)

    def disponibilidade(self, checkin, checkout, adultos=2, criancas=0, origem=None):
        rota = f"/api/disponibilidade?checkin={checkin}&checkout={checkout}&adultos={adultos}&criancas={criancas}"
        if origem:
            rota += f"&origem={origem}"
        return self.get(rota, token=None)

    def opcoes(self, checkin, checkout, adultos=2, criancas=0, origem=None):
        st, r = self.disponibilidade(checkin, checkout, adultos, criancas, origem)
        assert st == 200, (st, r)
        return {o["tipo"]: o for o in r["opcoes"]}

    def msg(self, telefone, texto):
        st, r = self.post("/api/mensagens", {"telefone": telefone, "texto": texto}, token=None)
        assert st == 200, (st, r)
        return "\n".join(r["respostas"])

    def saida(self, tipo=None):
        st, r = self.get("/api/saida")
        assert st == 200, (st, r)
        return [m for m in r["mensagens"] if tipo is None or m["tipo"] == tipo]

    def rodar(self, agora=None):
        st, r = self.post("/api/tarefas/rodar", {"agora": agora} if agora else {})
        assert st == 200, (st, r)
        return r["enviadas"]


