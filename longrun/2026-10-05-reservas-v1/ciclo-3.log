def esperar(cond, segundos=5):
    import time
    fim = time.time() + segundos
    while time.time() < fim:
        if cond():
            return True
        time.sleep(0.05)
    return cond()
"""HTTP adapter; each request owns a transaction and its SQLite connection."""
import argparse
import calendar
import hmac
import json
from datetime import date, timedelta
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, urlsplit

from .conversation import Conversation
from .domain import Store, Error, ROOT, hoje, agora, noites, telefone, decimal, arred


def dispatch(store, db, method, path, query, body):
    parts = path.strip('/').split('/')
    chat = Conversation(store, db)
    if path == '/api/mensagens' and method == 'POST':
        return 200, chat.message(body.get('telefone', ''), body.get('texto', ''))
    if path == '/api/saida' and method == 'GET':
        return 200, dict(mensagens=store.all(db, 'saida'))
    if path == '/api/espera':
        if method == 'GET':
            return 200, dict(espera=store.all(db, 'espera'))
        if method == 'POST':
            return 201, dict(id=chat.wait(body)['id'])
    if path == '/api/tarefas/rodar' and method == 'POST':
        return 200, chat.tasks(body.get('agora') or agora())
    if path == '/api/atendimento-humano' and method == 'GET':
        return 200, dict(fila=[a for a in store.all(db, 'atendimentos') if a['status'] == 'aberto'])
    if len(parts) == 4 and parts[1] == 'atendimento-humano' and method == 'POST':
        item = store.get(db, 'atendimentos', parts[2])
        if parts[3] == 'encerrar':
            item['status'] = 'encerrado'
            store.save(db, 'atendimentos', item)
            state = chat.session(item['telefone'])
            state.update(erros=0, fluxo=None)
            chat.save('conversas', state)
            return 200, dict(status='encerrado')
        if parts[3] == 'responder':
            guest = chat.guest(item['telefone']) or dict(id=None, telefone=item['telefone'], nao_contatar=chat.session(number)['nao_contatar'])
            chat.output(guest, 'humano', body['texto'])
            return 200, dict(ok=True)
    if method == 'GET' and path == '/api/saude':
        return 200, dict(ok=True, versao=(ROOT / 'VERSION').read_text().strip())
    if method == 'GET' and path == '/api/tipos':
        return 200, dict(tipos=store.tipos(db))
    if method == 'GET' and path == '/api/disponibilidade':
        for key, default in (('adultos', None), ('criancas', '0')):
            try:
                query[key] = int(query.get(key, default))
            except (TypeError, ValueError):
                raise Error(422, 'formato')
        return 200, store.disponibilidade(db, query)
    if path == '/api/hospedes' and method == 'POST':
        number = telefone(body.get('telefone', ''))
        previous = next((h for h in store.all(db, 'hospedes') if h['telefone'] == number), None)
        if previous:
            return 200, dict(id=previous['id'])
        guest = dict(nome=body.get('nome', ''), telefone=number, email=body.get('email'), documento=body.get('documento'), consentimento_marketing=body.get('consentimento_marketing', False), nao_contatar=chat.session(number)['nao_contatar'])
        return 201, dict(id=store.add(db, 'hospedes', guest)['id'])
    if len(parts) == 4 and parts[1] == 'hospedes' and parts[3] == 'dados' and method == 'GET':
        guest = store.get(db, 'hospedes', parts[2])
        reservations = [store.expand(db, r) for r in store.all(db, 'reservas') if r['hospede_id'] == guest['id']]
        return 200, dict(hospede=guest, reservas=reservations, mensagens=[{k: m[k] for k in ('direcao', 'texto', 'quando')} for m in chat.rows('mensagens') if m['telefone'] == guest['telefone']])
    if path == '/api/reservas':
        if method == 'POST':
            return 201, store.reserva(db, body)
        if method == 'GET':
            rows = store.all(db, 'reservas')
            for key in ('checkin', 'checkout', 'hospede_id'):
                if key in query:
                    rows = [r for r in rows if str(r[key]) == query[key]]
            if 'de' in query and 'ate' in query:
                rows = [r for r in rows if r['checkin'] <= query['ate'] and r['checkout'] > query['de']]
            return 200, dict(reservas=[store.expand(db, r) for r in sorted(rows, key=lambda r: (r['checkin'], r['id']))])
    if len(parts) >= 3 and parts[1] == 'reservas':
        r = store.get(db, 'reservas', parts[2])
        if len(parts) == 3:
            if method == 'GET':
                return 200, store.expand(db, r)
            if method == 'PUT':
                if 'hospede_id' in body:
                    r['hospede_id'] = store.get(db, 'hospedes', body['hospede_id'])['id']
                if 'observacoes' in body:
                    r['observacoes'] = body['observacoes']
                if 'total' in body:
                    r['total'] = float(arred(decimal(body['total'])))
                    r['sinal'] = float(arred(decimal(r['total'])*decimal(store.config['sinal_pct'])/100)) if r['origem'] in ('direta', 'balcao') else 0
                    r['detalhe']['informado'] = True
                store.save(db, 'reservas', r)
                return 200, store.expand(db, r)
        if len(parts) == 4 and method == 'POST':
            action = parts[3]
            allowed = {'cancelar': ('confirmada', 'hospedada'), 'checkin': ('confirmada',), 'checkout': ('hospedada',), 'no-show': ('confirmada',)}
            if action in allowed and r['status'] not in allowed[action]:
                raise Error(409, 'status')
            if action == 'cancelar':
                r['status'] = 'cancelada'
                r['gratis'] = (hoje()+timedelta(days=store.config['cancelamento_gratis_dias'])).isoformat() <= r['checkin']
                result = dict(status=r['status'], gratis=r['gratis'])
            elif action == 'checkin':
                rooms = sorted([q['id'] for q in store.all(db, 'quartos') if q['tipo'] == r['tipo']])
                selected = body.get('quarto')
                if selected is not None and selected not in rooms:
                    raise Error(422, 'quarto')
                def available(room):
                    conflicts = any(x['id'] != r['id'] and x.get('quarto') == room and x['status'] in ('confirmada', 'hospedada') and x['checkin'] < r['checkout'] and r['checkin'] < x['checkout'] for x in store.all(db, 'reservas'))
                    blocked = any(b.get('quarto') == room and b['de'] < r['checkout'] and r['checkin'] <= b['ate'] for b in store.all(db, 'bloqueios'))
                    return not (conflicts or blocked)
                candidates = [selected] if selected else rooms
                free = [q for q in candidates if available(q)]
                if candidates and not free:
                    raise Error(409, 'quarto')
                r.update(status='hospedada', quarto=free[0] if free else None)
                result = dict(status=r['status'], quarto=r['quarto'])
            elif action == 'checkout':
                r.update(status='finalizada', checkout_real=agora()[:10])
                result = dict(status=r['status'])
            elif action == 'no-show':
                r['status'] = 'no_show'
                result = dict(status=r['status'])
            elif action == 'sinal':
                r['sinal_pago'] = bool(body.get('pago'))
                result = dict(sinal_pago=r['sinal_pago'])
            else:
                raise Error(404, 'rota')
            store.save(db, 'reservas', r)
            if action in ('cancelar', 'no-show'):
                chat.offer(r['tipo'])
            return 200, result
    if len(parts) >= 2 and parts[1] in ('bloqueios', 'fechamentos'):
        collection = parts[1]
        if len(parts) == 2 and method == 'GET':
            rows = store.all(db, collection)
            if 'quarto' in query:
                rows = [r for r in rows if r.get('quarto') == query['quarto']]
            return 200, {collection: rows}
        if len(parts) == 3 and method == 'DELETE':
            store.get(db, collection, parts[2])
            db.execute('DELETE FROM objetos WHERE colecao=? AND id=?', (collection, parts[2]))
            return 204, None
        if len(parts) == 2 and method == 'POST':
            try:
                nights = list(noites(body['de'], (date.fromisoformat(body['ate'])+timedelta(days=1)).isoformat()))
                if not nights:
                    raise ValueError()
            except (ValueError, KeyError, TypeError):
                raise Error(422, 'datas')
            item = dict(de=body['de'], ate=body['ate'], motivo=body.get('motivo', ''))
            if collection == 'bloqueios':
                room = body.get('quarto')
                try:
                    kind = store.get(db, 'quartos', room)['tipo'] if room else body['tipo']
                    store.get(db, 'tipos', kind)
                except (Error, KeyError):
                    raise Error(422, 'tipo')
                item.update(tipo=kind, quarto=room)
            saved = store.add(db, collection, item)
            conflicts = []
            for r in store.all(db, 'reservas'):
                if r['status'] not in ('confirmada', 'hospedada') or (collection == 'bloqueios' and r['tipo'] != item['tipo']):
                    continue
                for n in nights:
                    if r['checkin'] <= n < r['checkout']:
                        inv = store.inventory(db, r['tipo'], n)
                        units = next(t['unidades'] for t in store.tipos(db) if t['id'] == r['tipo'])
                        if inv['ocupadas']+inv['bloqueadas'] > units or (collection == 'bloqueios' and item['quarto'] and r['quarto'] == item['quarto'] and r['status'] == 'hospedada'):
                            conflicts.append(r['id'])
                            break
            return 201, dict(id=saved['id'], conflitos=conflicts)
    if path == '/api/dia' and method == 'GET':
        day = query.get('data', hoje().isoformat())
        rows = sorted(store.all(db, 'reservas'), key=lambda r: r['id'])
        return 200, dict(data=day,
            chegadas=[store.expand(db, r) for r in rows if r['checkin'] == day and r['status'] in ('confirmada', 'hospedada')],
            saidas=[store.expand(db, r) for r in rows if r['checkout'] == day and r['status'] in ('hospedada', 'finalizada')],
            hospedados=sum(r['status'] == 'hospedada' and r['checkin'] <= day < r['checkout'] for r in rows))
    if path == '/api/ocupacao' and method == 'GET':
        month = query['mes']
        year, mon = map(int, month.split('-'))
        kinds = store.tipos(db)
        days = []
        for d in range(1, calendar.monthrange(year, mon)[1]+1):
            day = f'{month}-{d:02d}'
            by_kind = {t['id']: store.inventory(db, t['id'], day) for t in kinds}
            days.append(dict(data=day, por_tipo=by_kind, **{k: sum(v[k] for v in by_kind.values()) for k in ('ocupadas', 'bloqueadas', 'livres')}))
        return 200, dict(mes=month, unidades=sum(t['unidades'] for t in kinds), dias=days)
    raise Error(404, 'rota')


def serve(args):
    store = Store(args.dados)

    class Handler(BaseHTTPRequestHandler):
        def handle_request(self):
            path = urlsplit(self.path).path
            public = (self.command == 'GET' and path in ('/', '/equipe', '/api/saude', '/api/tipos', '/api/disponibilidade')) or (self.command == 'POST' and path == '/api/mensagens') or path.startswith(('/ical/', '/webhook/'))
            try:
                if not public and not hmac.compare_digest(self.headers.get('X-Token', '').encode(), str(store.config['token']).encode()):
                    raise Error(401, 'token')
                try:
                    length = int(self.headers.get('Content-Length', '0'))
                    if length < 0 or length > 2_000_000:
                        raise Error(413, 'corpo')
                    body = json.loads(self.rfile.read(length)) if length else {}
                    if not isinstance(body, dict):
                        raise ValueError()
                except (ValueError, UnicodeDecodeError):
                    raise Error(400, 'json')
                query = {k: v[-1] for k, v in parse_qs(urlsplit(self.path).query).items()}
                db = store.connect()
                try:
                    with db:
                        # Reserve the writer before checking capacity: no check/write race.
                        if self.command != 'GET':
                            db.execute('BEGIN IMMEDIATE')
                        else:
                            db.execute('BEGIN')
                        status, result = dispatch(store, db, self.command, path, query, body)
                finally:
                    db.close()
            except Error as exc:
                status, result = exc.status, exc.body
            except (ValueError, KeyError, TypeError):
                status, result = 422, dict(erro='formato')
            data = json.dumps(result, ensure_ascii=False).encode() if result is not None else b''
            self.send_response(status)
            self.send_header('Content-Type', 'application/json; charset=utf-8')
            self.send_header('Content-Length', str(len(data)))
            self.end_headers()
            self.wfile.write(data)

        do_GET = do_POST = do_PUT = do_DELETE = handle_request

        def log_message(self, *args):
            pass

    server = ThreadingHTTPServer((args.host, args.porta), Handler)
    print(f'PORTA={server.server_port}', flush=True)
    server.serve_forever()


def main():
    parser = argparse.ArgumentParser(description='Reservas de pousada')
    commands = parser.add_subparsers(dest='command', required=True)
    server = commands.add_parser('serve')
    server.add_argument('--porta', type=int, default=8080)
    server.add_argument('--host', default='127.0.0.1')
    server.add_argument('--dados', default='dados')
    args = parser.parse_args()
    serve(args)
"""Persistent inventory and pricing. All money arithmetic uses Decimal."""
import json
import os
import re
import shutil
import sqlite3
from datetime import date, datetime, timedelta
from decimal import Decimal, ROUND_HALF_UP
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
COLLECTIONS = ('tipos', 'quartos', 'temporadas', 'estadias_minimas', 'fechamentos', 'faq')


class Error(Exception):
    def __init__(self, status, erro, **fields):
        self.status = status
        self.body = dict(erro=erro, **fields)


def agora():
    return os.environ.get('RESERVA_AGORA') or datetime.now().isoformat(timespec='minutes')


def hoje():
    return date.fromisoformat(agora()[:10])


def decimal(value):
    return Decimal(str(value))


def arred(value):
    return value.quantize(Decimal('0.01'), rounding=ROUND_HALF_UP)


def noites(inicio, fim):
    d = date.fromisoformat(inicio)
    end = date.fromisoformat(fim)
    while d < end:
        yield d.isoformat()
        d += timedelta(days=1)


def telefone(value):
    digits = re.sub(r'\D', '', str(value))
    if len(digits) in (10, 11):
        return '+55' + digits
    if len(digits) in (12, 13) and digits.startswith('55'):
        return '+' + digits
    raise Error(400, 'telefone')


class Store:
    def __init__(self, directory):
        directory = Path(directory)
        directory.mkdir(parents=True, exist_ok=True)
        config = directory / 'pousada.json'
        if not config.exists():
            shutil.copyfile(ROOT / 'exemplos/pousada.json', config)
        self.config = json.loads(config.read_text())
        self.path = directory / 'reserva.sqlite3'
        with self.connect() as db:
            db.execute('CREATE TABLE IF NOT EXISTS objetos (colecao TEXT, id TEXT, dados TEXT, PRIMARY KEY(colecao,id))')
            db.execute('CREATE TABLE IF NOT EXISTS meta (chave TEXT PRIMARY KEY, valor TEXT)')
            if not db.execute("SELECT 1 FROM meta WHERE chave='semente'").fetchone():
                for collection in COLLECTIONS:
                    for i, item in enumerate(self.config.get(collection, []), 1):
                        self.save(db, collection, dict(item, id=item.get('id', i)))
                db.execute("INSERT INTO meta VALUES ('semente','1')")

    def connect(self):
        return sqlite3.connect(self.path, timeout=30)

    def all(self, db, collection):
        return [json.loads(row[0]) for row in db.execute('SELECT dados FROM objetos WHERE colecao=? ORDER BY rowid', (collection,))]

    def get(self, db, collection, ident):
        row = db.execute('SELECT dados FROM objetos WHERE colecao=? AND id=?', (collection, str(ident))).fetchone()
        if row is None:
            raise Error(404, 'inexistente')
        return json.loads(row[0])

    def save(self, db, collection, item):
        db.execute('INSERT INTO objetos VALUES (?,?,?) ON CONFLICT(colecao,id) DO UPDATE SET dados=excluded.dados',
                   (collection, str(item['id']), json.dumps(item, ensure_ascii=False)))
        return item

    def add(self, db, collection, item):
        ident = db.execute('SELECT COALESCE(MAX(CAST(id AS INTEGER)),0)+1 FROM objetos WHERE colecao=?', (collection,)).fetchone()[0]
        return self.save(db, collection, dict(item, id=ident))

    def tipos(self, db):
        result = []
        rooms = self.all(db, 'quartos')
        for item in self.all(db, 'tipos'):
            if item.get('ativo', True):
                item['ocupacao_base'] = item.get('ocupacao_base', 2)
                item['unidades'] = sum(q['tipo'] == item['id'] for q in rooms) or item['unidades']
                result.append(item)
        return result

    def inventory(self, db, tipo, night):
        units = next(t['unidades'] for t in self.tipos(db) if t['id'] == tipo)
        occupied = sum(r['tipo'] == tipo and r['status'] in ('confirmada', 'hospedada') and r['checkin'] <= night < r['checkout'] for r in self.all(db, 'reservas'))
        blocked = sum(b['tipo'] == tipo and b['de'] <= night <= b['ate'] for b in self.all(db, 'bloqueios'))
        if any(f['de'] <= night <= f['ate'] for f in self.all(db, 'fechamentos')):
            blocked += units
        return dict(ocupadas=occupied, bloqueadas=blocked, livres=max(0, units-occupied-blocked))

    def validate(self, db, body, tipo=None):
        try:
            for key in ('checkin', 'checkout'):
                if not re.fullmatch(r'\d{4}-\d{2}-\d{2}', body[key]):
                    raise ValueError()
            start, end = (date.fromisoformat(body[k]) for k in ('checkin', 'checkout'))
            adults, kids = body['adultos'], body.get('criancas', 0)
            if type(adults) is not int or type(kids) is not int:
                raise ValueError()
        except (KeyError, ValueError, TypeError):
            raise Error(422, 'formato')
        if end <= start or start < hoje() or start > hoje() + timedelta(days=self.config['janela_dias']):
            raise Error(422, 'datas')
        t = self.get(db, 'tipos', tipo) if tipo is not None else None
        if t and not t.get('ativo', True):
            raise Error(422, 'tipo')
        if adults < 1 or kids < 0 or (t and (adults > t['adultos_max'] or kids > t['criancas_max'])):
            raise Error(422, 'capacidade')
        nights = list(noites(start.isoformat(), end.isoformat()))
        if any(f['de'] <= n <= f['ate'] for f in self.all(db, 'fechamentos') for n in nights):
            raise Error(422, 'fechado')
        minimum = max([f['noites'] for f in self.all(db, 'estadias_minimas') if any(f['de'] <= n <= f['ate'] for n in nights)] or [1])
        if len(nights) < minimum:
            raise Error(422, 'estadia_minima', minimo=minimum)
        return nights

    def price(self, db, t, nights, adults, kids, origin, informed=None):
        daily, low = [], []
        seasons = self.all(db, 'temporadas')
        for n in nights:
            season = next((s for s in seasons if s['de'] <= n <= s['ate'] and t['id'] in s['precos']), None)
            value = decimal(season['precos'][t['id']] if season else t['tarifa_base'])
            daily.append(dict(data=n, valor=float(value), temporada=season['id'] if season else None))
            if season and season['tipo'] == 'baixa':
                low.append(value)
        package = self.config.get('pacote_baixa')
        k = len(low)//package['noites']*(package['noites']-package['pagas']) if package else 0
        free = sum(sorted(low)[:k], Decimal(0))
        extra = decimal(t['pessoa_extra'])*max(0, adults+kids-t.get('ocupacao_base', 2))*len(nights)
        subtotal = sum((decimal(d['valor']) for d in daily), Decimal(0))+extra-free
        direct = origin in ('direta', 'balcao')
        discount = arred(subtotal*decimal(self.config['desconto_direto_pct'])/100) if direct else Decimal(0)
        total = arred(decimal(informed)) if informed is not None else subtotal-discount
        signal = arred(total*decimal(self.config['sinal_pct'])/100) if direct else Decimal(0)
        return dict(total=float(total), sinal=float(signal), detalhe=dict(diarias=daily, pessoa_extra=float(extra), pacote_baixa=float(free), subtotal=float(subtotal), desconto_direto=float(discount), informado=informed is not None))

    def disponibilidade(self, db, body):
        nights = self.validate(db, body)
        adults, kids, origin = body['adultos'], body.get('criancas', 0), body.get('origem', 'direta')
        options = []
        for t in self.tipos(db):
            if adults > t['adultos_max'] or kids > t['criancas_max']:
                continue
            available = min(self.inventory(db, t['id'], n)['livres'] for n in nights)
            if available:
                options.append(dict(tipo=t['id'], nome=t['nome'], disponiveis=available, beneficio=self.config['beneficio_direto'] if origin in ('direta', 'balcao') else None, **self.price(db, t, nights, adults, kids, origin)))
        return dict(checkin=body['checkin'], checkout=body['checkout'], noites=len(nights), adultos=adults, criancas=kids, origem=origin, opcoes=options)

    def reserva(self, db, body):
        nights = self.validate(db, body, body.get('tipo'))
        guest = self.get(db, 'hospedes', body.get('hospede_id'))
        t = self.get(db, 'tipos', body['tipo'])
        if not all(self.inventory(db, t['id'], n)['livres'] for n in nights):
            raise Error(409, 'sem_disponibilidade')
        origin = body.get('origem', 'balcao')
        kids = body.get('criancas', 0)
        item = dict(status='confirmada', hospede_id=guest['id'], tipo=t['id'], quarto=None, checkin=body['checkin'], checkout=body['checkout'], noites=len(nights), adultos=body['adultos'], criancas=kids, origem=origin, sinal_pago=False, chegada_confirmada=False, pre_checkin=None, observacoes=body.get('observacoes'), gratis=None, ical_uid=None, criada_em=agora())
        item.update(self.price(db, t, nights, body['adultos'], kids, origin, body.get('total')))
        return self.expand(db, self.add(db, 'reservas', item))

    def expand(self, db, reservation):
        guest = self.get(db, 'hospedes', reservation['hospede_id']) if reservation['hospede_id'] else {}
        return dict(reservation, nome=guest.get('nome'), telefone=guest.get('telefone'))

