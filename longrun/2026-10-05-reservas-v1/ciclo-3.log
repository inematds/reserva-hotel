        assert st in (200, 201), (st, r)
        return r["id"]

    def reserva(self, hospede_id, checkin, checkout, tipo="standard", adultos=2, criancas=0, origem=None, total=None):
        corpo = {"hospede_id": hospede_id, "tipo": tipo, "checkin": checkin, "checkout": checkout,
                 "adultos": adultos, "criancas": criancas}
        if origem:
            corpo["origem"] = origem
        if total is not None:
            corpo["total"] = total
        return self.post("/api/reservas", corpo)

    def disponibilidade(self, checkin, checkout, adultos=2, criancas=0, origem=None):
        rota = f"/api/disponibilidade?checkin={checkin}&checkout={checkout}&adultos={adultos}&criancas={criancas}"
        if origem:
            rota += f"&origem={origem}"
        return self.get(rota, token=None)

    def opcoes(self, checkin, checkout, adultos=2, criancas=0, origem=None):
        st, r = self.disponibilidade(checkin, checkout, adultos, criancas, origem)
        assert st == 200, (st, r)
        return {o["tipo"]: o for o in r["opcoes"]}

    def msg(self, telefone, texto):
        st, r = self.post("/api/mensagens", {"telefone": telefone, "texto": texto}, token=None)
        assert st == 200, (st, r)
        return "\n".join(r["respostas"])

    def saida(self, tipo=None):
        st, r = self.get("/api/saida")
        assert st == 200, (st, r)
        return [m for m in r["mensagens"] if tipo is None or m["tipo"] == tipo]

    def rodar(self, agora=None):
        st, r = self.post("/api/tarefas/rodar", {"agora": agora} if agora else {})
        assert st == 200, (st, r)
        return r["enviadas"]


